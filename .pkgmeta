package-as: MogWhere

enable-nolib-creation: no

move-folders:
    MogWhere/addon/MogWhere: MogWhere

ignore:
    - scripts
    - media
    # Project page copy. It shipped in 0.2.0, which put a marketing document in
    # every player's AddOns folder.
    - docs
    - .luacheckrc
    - .github
    - CHANGELOG.md

optional-dependencies:
    - all-the-things
    - tomtom
